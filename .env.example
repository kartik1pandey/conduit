# Copy to .env and fill in real values locally. Never commit the real .env file.
# CONDUIT_MODE stays "test" everywhere in this project — there is no live-money path.
CONDUIT_MODE=test

# --- Postgres: one logical database per service, separate schemas or separate instances either work ---
CORE_DATABASE_URL=postgres://conduit:conduit@localhost:5432/conduit_core
LEDGER_DATABASE_URL=postgres://conduit:conduit@localhost:5432/conduit_ledger
RISK_DATABASE_URL=postgres://conduit:conduit@localhost:5432/conduit_risk
BILLING_DATABASE_URL=postgres://conduit:conduit@localhost:5432/conduit_billing
WEBHOOKS_DATABASE_URL=postgres://conduit:conduit@localhost:5432/conduit_webhooks

# --- Redis: idempotency cache, balance cache, rate limiting, webhook retry scheduling ---
REDIS_URL=redis://localhost:6379

# --- Auth secrets: generate real random values, e.g. `openssl rand -hex 32` ---
INTERNAL_JWT_SECRET=replace-with-a-real-generated-secret
DASHBOARD_SESSION_SECRET=replace-with-a-real-generated-secret
# Note: webhook payload signing does NOT use a global secret here — each
# registered webhook endpoint gets its own randomly generated HMAC secret at
# registration time (mirroring Stripe's per-endpoint signing secret), shown
# to the merchant once. A single shared secret would mean one leak
# compromises every merchant's webhooks instead of just one endpoint's.

# --- Inter-service URLs (values shown match docker-compose service names) ---
CONDUIT_CORE_URL=http://conduit-core:8000
CONDUIT_RISK_URL=http://conduit-risk:8001
CONDUIT_LEDGER_URL=http://conduit-ledger:8002
CONDUIT_WEBHOOKS_URL=http://conduit-webhooks:8003
CONDUIT_BILLING_URL=http://conduit-billing:8004

# --- conduit-risk's OPA sidecar (evaluates policies/risk.rego) ---
OPA_URL=http://opa:8181

# --- Reliability tuning (sensible defaults, adjust as needed) ---
IDEMPOTENCY_KEY_TTL_HOURS=24
WEBHOOK_MAX_RETRIES=8
RATE_LIMIT_REQUESTS_PER_MINUTE=100
